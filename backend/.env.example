# Talkdesk OAuth 2.0 Client Credentials grant - https://docs.talkdesk.com/docs/client-credentials
TALKDESK_ACCOUNT_SUBDOMAIN=your_account
TALKDESK_CLIENT_ID=
TALKDESK_CLIENT_SECRET=
TALKDESK_SCOPE=cases:read

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/talkdesk_sync

# Comma-separated list of origins allowed to call this API (React dev servers)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
